# telectl configuration
#
# Copy to one of the searched locations:
#   ~/.config/telectl/telectl.yaml
#   ~/.config/telectl.yaml
#   /etc/telectl/telectl.yaml
# or pass an explicit path with --config.
#
# Any key can be overridden by an environment variable: upper-case it, replace
# dots with underscores, and prefix with TELECTL_ —
#   bot.rate_limit        -> TELECTL_BOT_RATE_LIMIT
#   kubernetes.dry_run    -> TELECTL_KUBERNETES_DRY_RUN
#
# Credentials keep their conventional unprefixed names, listed below.
#
# See docs/CONFIGURATION.md for the full reference.

telegram:
  # Bot token from @BotFather (required)
  # Can also be set via TELEGRAM_BOT_TOKEN env var
  bot_token: ""

  # Telegram user IDs permitted to use this bot.
  #
  # An empty list allows EVERYONE who can find the bot to operate your
  # cluster. Always set this in production. Get your ID from @userinfobot.
  # Can also be set via ALLOWED_USER_IDS (comma-separated).
  allowed_user_ids: []

  # Reserved for privileged operations. Can also be set via ADMIN_USER_IDS.
  admin_user_ids: []

  # Message parse mode: MarkdownV2, HTML, or empty for plain text
  parse_mode: "MarkdownV2"

  # Webhook mode is not implemented yet; telectl uses long polling.
  # These are read but currently unused.
  webhook_url: ""
  webhook_port: 8443

kubernetes:
  # Path to kubeconfig file (default: ~/.kube/config)
  # Can also be set via KUBECONFIG env var
  kubeconfig_path: ""

  # Default namespace for commands
  default_namespace: "default"

  # Specific context to use (empty = use current context from kubeconfig)
  context: ""

  # Request timeout in seconds
  timeout: 30

  # Log mutating operations instead of performing them. Replies say so
  # explicitly, so a dry run is never mistaken for a real change.
  dry_run: false

  # Cluster name for display purposes (shown in /config, /version, main menu)
  # If empty, uses the current kubeconfig context name
  cluster_name: ""

  # Not implemented yet; read but unused.
  impersonate_user: ""
  impersonate_groups: []

  # client-go rate limiting against the API server. Distinct from
  # bot.rate_limit below, which throttles per Telegram user.
  burst: 10
  qps: 5.0

# Impersonation configuration
# When enabled, the bot will impersonate different K8s users/groups
# based on the Telegram user ID. This allows per-user RBAC.
impersonation:
  # Enable impersonation feature
  enabled: false

  # Default user to impersonate when no specific mapping exists
  # Can be a username or serviceaccount (e.g., "system:serviceaccount:default:readonly")
  default_user: ""

  # Default groups to impersonate when no specific mapping exists
  default_groups: []

  # Per-Telegram-user mapping to K8s user/groups
  # Key is the Telegram user ID (as string), value is user/groups
  # Example:
  # user_mapping:
  #   "123456789":    # Telegram user ID
  #     user: "admin-user"
  #     groups: ["system:masters", "platform-team"]
  #   "987654321":
  #     user: "dev-user"
  #     groups: ["developers"]
  user_mapping: {}

logging:
  # Log level: debug, info, warn, error
  level: "info"

  # Log format: json, console
  format: "json"

  # Log output: stdout, stderr
  output: "stdout"

bot:
  # Maximum message length (Telegram limit is 4096)
  max_message_length: 4096

  # Command prefix
  command_prefix: "/"

  # Enable Markdown formatting
  enable_markdown: true

  # Rate limit per user per minute
  rate_limit: 30

  # Menu system
  enable_menu_button: true
  enable_reply_keyboard: true
  menu_page_size: 10

  # Commands the bot will dispatch. Must stay in sync with the handlers
  # registered in bot.registerHandlers: a command missing from this list is
  # rejected as "not allowed" even though its handler exists. Note the key is
  # "portforward", not "port-forward".
  allowed_commands:
    - "start"
    - "help"
    - "about"
    - "version"
    - "get"
    - "describe"
    - "logs"
    - "exec"
    - "portforward"
    - "contexts"
    - "use-context"
    - "config"
    - "top"
    - "events"
    - "watch"
    - "restart"
    - "scale"
    - "resources"
    - "monitor"
    - "operations"
    - "settings"